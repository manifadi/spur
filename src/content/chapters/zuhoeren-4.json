    {
      "id": "z4-elternabend",
      "title": "Elternabend",
      "items": [
        {
          "id": "z4-elternabend-d",
          "type": "dialog",
          "title": "Elternabend",
          "characterId": "frau-demir",
          "lines": [
            {
              "who": "Frau Demir",
              "text": "Guten Abend zusammen. Die Klassenfahrt geht dieses Jahr nach Rügen, vom 12. bis 16. Mai. Wir wohnen in einer Jugendherberge direkt am Strand. Kosten: 240 Euro pro Kind, inklusive Vollpension."
            },
            {
              "who": "Herr Lindqvist",
              "text": "Gibt es dafür einen Zuschuss?"
            },
            {
              "who": "Frau Demir",
              "text": "Ja, über den Förderverein. Den Antrag bitte bis Ende März bei Herrn Oswald im Sekretariat abgeben. Das Formular gibt es auch auf der Schulwebsite."
            },
            {
              "who": "Frau Petrović",
              "text": "Und wer begleitet die Fahrt?"
            },
            {
              "who": "Frau Demir",
              "text": "Ich und Herr Brandt, der Sportlehrer. Außerdem suchen wir noch einen Elternteil mit Erste-Hilfe-Kenntnissen. Wer Lust hat, meldet sich bitte bis zu den Osterferien bei mir."
            },
            {
              "who": "Herr Lindqvist",
              "text": "Müssen die Kinder Bettwäsche mitbringen?"
            },
            {
              "who": "Frau Demir",
              "text": "Nein, die gibt es in der Jugendherberge. Aber bitte feste Schuhe und eine Regenjacke, wir machen eine Wanderung zu den Kreidefelsen. Handys sammeln wir abends ein, das haben die Kinder selbst so abgestimmt."
            }
          ],
          "subExercises": [
            {
              "id": "q1",
              "type": "recall_text",
