      "items": [
        {
          "id": "z4-werkstatt-d",
          "type": "dialog",
          "title": "Werkstatt",
          "characterId": "meister-kowalski",
          "lines": [
            {
              "who": "Meister Kowalski",
              "text": "Also. Die Bremsbeläge vorne sind runter, die tauschen wir. Das Klappern hinten kam vom Hitzeschutzblech, das haben wir nur festgeschraubt. Hat nichts gekostet."
            },
            {
              "who": "Frau Heller",
              "text": "Immerhin. Und was kostet der Rest?"
            },
            {
              "who": "Meister Kowalski",
              "text": "Mit Belägen und Arbeit rund 280 Euro. Morgen ab 16 Uhr ist der Wagen fertig."
            },
            {
              "who": "Azubi Timo",
              "text": "Chef, beim Reifenwechsel hab ich gesehen: Der linke Scheinwerfer ist auch kaputt."
            },
            {
              "who": "Meister Kowalski",
              "text": "Stimmt. Den machen wir gleich mit, das Birnchen kostet nur acht Euro. Und Frau Heller: Die Winterreifen haben noch zwei Winter, dann müssen neue her."
            },
            {
              "who": "Frau Heller",
              "text": "Zwei Winter. Ich schreib's mir auf. Irgendwann."
            },
            {
              "who": "Azubi Timo",
              "text": "Soll ich den Wagen noch waschen, Chef?"
            },
            {
              "who": "Meister Kowalski",
              "text": "Nein, Timo. Wir sind eine Werkstatt, keine Waschanlage."
            }
          ],
