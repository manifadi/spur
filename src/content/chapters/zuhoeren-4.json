    {
      "id": "z4-besichtigung",
      "title": "Besichtigung",
      "items": [
        {
          "id": "z4-besichtigung-d",
          "type": "dialog",
          "title": "Wohnungsbesichtigung",
          "characterId": "frau-sommer",
          "lines": [
            {
              "who": "Frau Sommer",
              "text": "Kommen Sie rein. Die Wohnung hat 68 Quadratmeter, drei Zimmer und einen Balkon nach Westen — also Abendsonne."
            },
            {
              "who": "Jonte",
              "text": "Und wie wird geheizt?"
            },
            {
              "who": "Frau Sommer",
              "text": "Fernwärme. Die Nebenkosten liegen bei 190 Euro im Monat. Der Keller gehört dazu, der Stellplatz kostet extra."
            },
            {
              "who": "Lea",
              "text": "Sind Haustiere erlaubt? Wir haben zwei Kaninchen, Fritz und Frieda."
            },
            {
              "who": "Frau Sommer",
              "text": "Kleintiere ja. Hunde nur nach Absprache mit dem Eigentümer, aber Kaninchen sind kein Problem."
            },
            {
              "who": "Jonte",
              "text": "Wie ist es mit dem Lärm? Die Straße vorne wirkt ziemlich belebt."
            },
            {
              "who": "Frau Sommer",
              "text": "Die Schlafzimmer gehen nach hinten in den Hof, da ist es ruhig. Vorne ist nur die Küche. Und die Fenster sind vor zwei Jahren erneuert worden."
            }
          ],
          "subExercises": [
