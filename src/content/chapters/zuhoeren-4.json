    {
      "id": "z4-abendessen-2",
      "title": "Abendessen, Teil 2",
      "items": [
        {
          "id": "z4-abendessen-d2",
          "type": "dialog",
          "title": "Abendessen, Teil 2",
          "characterId": "yusuf",
          "lines": [
            {
              "who": "Yusuf",
              "text": "Bevor die Fjorde kommen, hab ich noch eine Neuigkeit: Ich fange im Mai bei einer Baumschule in Pinneberg an. Endlich raus aus dem Büro."
            },
            {
              "who": "Marta",
              "text": "Pinneberg? Dann fährst du ja jeden Tag über eine Stunde."
            },
            {
              "who": "Yusuf",
              "text": "Fünfzig Minuten mit der S-Bahn. Und mein Fahrrad kann ich mitnehmen, die Baumschule liegt nochmal zehn Minuten vom Bahnhof weg."
            },
            {
              "who": "Ben",
              "text": "Und was machst du da genau?"
            },
            {
              "who": "Yusuf",
              "text": "Erst mal Obstbäume veredeln. Im Herbst dann Verkauf. Und ich darf mir jedes Jahr einen Baum aussuchen, das steht sogar im Vertrag."
            },
            {
              "who": "Marta",
              "text": "Einen Baum im Jahr? Dann will ich einen Kirschbaum für den Hof."
            },
            {
              "who": "Yusuf",
              "text": "Abgemacht. Aber du musst ihn selber gießen, ich komme nicht jeden Tag mit der S-Bahn vorbei."
            }
          ],
          "subExercises": [
            {
              "id": "q4",
              "type": "recall_text",
              "prompt": "Wo fängt Yusuf im Mai an?",
              "answers": [
                [
                  "Baumschule"
                ],
                [
                  "Pinneberg"
                ]
              ],
              "solution": "Bei einer Baumschule in Pinneberg.",
              "quote": "„Ich fange im Mai bei einer Baumschule in Pinneberg an.“"
            },
            {
              "id": "q5",
